# HP 7475A Web Controller — environment configuration
# Copy to .env and edit. All values optional; defaults shown.

# Bind address. Default 127.0.0.1 (localhost-only).
# For LAN access (trusted networks only — no auth built in):
#   HP7475A_HOST=0.0.0.0
HP7475A_HOST=127.0.0.1
HP7475A_PORT=8750

# Data directory (SQLite DB, uploads, previews)
HP7475A_DATA_DIR=data

# Upload caps
HP7475A_MAX_UPLOAD_BYTES=20971520
HP7475A_MAX_HPGL_BYTES=5242880

# Buffer-safe streaming (docs/hardware-notes.md §6)
HP7475A_STREAM_SAFETY_MARGIN=32
HP7475A_STREAM_DEFAULT_CHUNK=512
HP7475A_STREAM_QUERY_TIMEOUT_S=2.0
HP7475A_STREAM_MAX_RETRIES=3
HP7475A_COMPLETION_TIMEOUT_S=600.0

# Job history retention (terminal jobs kept)
HP7475A_JOB_HISTORY_KEEP=100
